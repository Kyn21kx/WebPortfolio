---
import '../styles/global.css';

const { url } = Astro;
const currentPath = url.pathname;
---

<header class='site-header'>
  <div class='container'>
    <nav class='navbar navbar-expand-lg navbar-dark p-0'>
      <a class='navbar-brand site-brand' href='/'>Leónidas Neftalí</a>

      <button
        class='navbar-toggler border-0 shadow-none'
        type='button'
        data-bs-toggle='collapse'
        data-bs-target='#navMenu'
        aria-controls='navMenu'
        aria-expanded='false'
        aria-label='Toggle navigation'
      >
        <span class='navbar-toggler-icon'></span>
      </button>

      <div class='collapse navbar-collapse' id='navMenu'>
        <ul class='navbar-nav ms-auto align-items-lg-center gap-lg-4 gap-2 my-2 my-lg-0'>
          <li class='nav-item'>
            <a class={`nav-link site-nav-link ${currentPath === '/' ? 'active' : ''}`} href='/'>Home</a>
          </li>
          <li class='nav-item'>
            <a class={`nav-link site-nav-link ${currentPath === '/about' ? 'active' : ''}`} href='/about'>About</a>
          </li>
          <li class='nav-item'>
            <a class={`nav-link site-nav-link ${currentPath === '/blog' ? 'active' : ''}`} href='/blog'>Blog</a>
          </li>
        </ul>
        <div class='site-social ms-lg-4 d-flex gap-3 my-2 my-lg-0'>
          <a href='https://github.com/Kyn21kx' class='social-link' target='_blank'>GitHub ↗</a>
          <a href='https://www.linkedin.com/in/le%C3%B3nidas-neftal%C3%AD-gonz%C3%A1lez-campos-7a650a16b/' class='social-link' target='_blank'>LinkedIn ↗</a>
        </div>
      </div>
    </nav>
  </div>
</header>
