---
import '../styles/global.css';
---

<footer class='footerBg py-5'>
  <div class='container'>
    <div class='row'>
      <div class='col-12 col-md-6 footerSection'>
        <a class='site-brand d-block mb-2' href='/'>Leónidas Neftalí</a>
        <p class='description'>Systems engineer.</p>
      </div>
      <div class='col-12 col-md-3 footerSection'>
        <p class='footer-heading'>Contact</p>
        <p class='description'>nefesmeralda@gmail.com</p>
        <p class='description'>+52 449 489 22 37</p>
      </div>
      <div class='col-12 col-md-3 footerSection'>
        <p class='footer-heading'>Elsewhere</p>
        <div class='socialIconsContainer'>
          <a target='_blank' class='socialMedia' href='https://github.com/Kyn21kx'>
            <i class='bi bi-github socialIcon'></i>
          </a>
          <a target='_blank' class='socialMedia' href='https://www.linkedin.com/in/le%C3%B3nidas-neftal%C3%AD-gonz%C3%A1lez-campos-7a650a16b/'>
            <i class='bi bi-linkedin socialIcon'></i>
          </a>
          <a target='_blank' class='socialMedia' href='https://www.instagram.com/i4mth3breakerbabe/'>
            <i class='bi bi-instagram socialIcon'></i>
          </a>
        </div>
      </div>
    </div>
    <hr class='footer-divider' />
    <p class='copyright text-center'>
      © 2026 Leónidas Neftalí González Campos
    </p>
  </div>
</footer>

<style>
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .footer-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0;
    opacity: 1;
  }
</style>
