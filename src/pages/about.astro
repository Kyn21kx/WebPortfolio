---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title='About'>
  <Header />
  <div class='about-wrapper'>
    <div class='about-content'>

      <section class='about-section'>
        <p class='about-label'>Systems Engineer</p>
        <h1 class='about-name'>Leónidas Neftalí<br />González Campos</h1>
        <p class='about-bio'>
          Six years building software that runs close to the metal — game engines,
          rendering pipelines, graphics tooling. Mostly C++ and Vulkan. Sometimes
          Godot. Always interested in what's underneath the abstraction.
        </p>
        <p class='about-bio'>
          I write occasionally about systems programming, the state of software, and
          things I'm learning. If any of that sounds interesting, the
          <a href='/blog'>blog</a> is a good place to start.
        </p>
      </section>

      <section class='about-section'>
        <h2 class='about-section-title'>Interests</h2>
        <ul class='about-list'>
          <li>Real-time rendering and graphics APIs (Vulkan, OpenGL)</li>
          <li>Game engine architecture and tooling</li>
          <li>Systems programming in C and C++</li>
          <li>Performance-oriented software design</li>
          <li>The craft of writing clear, minimal code</li>
        </ul>
      </section>

      <section class='about-section'>
        <h2 class='about-section-title'>Contact</h2>
        <div class='contact-list'>
          <div class='contact-row'>
            <span class='contact-label'>Email</span>
            <a href='mailto:nefesmeralda@gmail.com' class='contact-value'>nefesmeralda@gmail.com</a>
          </div>
          <div class='contact-row'>
            <span class='contact-label'>GitHub</span>
            <a href='https://github.com/Kyn21kx' target='_blank' class='contact-value'>Kyn21kx ↗</a>
          </div>
          <div class='contact-row'>
            <span class='contact-label'>LinkedIn</span>
            <a href='https://www.linkedin.com/in/le%C3%B3nidas-neftal%C3%AD-gonz%C3%A1lez-campos-7a650a16b/' target='_blank' class='contact-value'>Leónidas Neftalí ↗</a>
          </div>
          <div class='contact-row'>
            <span class='contact-label'>Phone</span>
            <span class='contact-value'>+52 449 489 22 37</span>
          </div>
        </div>
      </section>

    </div>
  </div>
  <Footer />
</Layout>

<style>
  .about-wrapper {
    padding: 5rem 0 6rem;
  }

  .about-content {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .about-section {
    margin-bottom: 3.5rem;
  }

  .about-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--blue);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .about-name {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--text);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .about-bio {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 1.1rem;
  }

  .about-bio a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(61, 127, 193, 0.35);
    transition: color 0.15s;
  }

  .about-bio a:hover { color: var(--blue-hover); }

  .about-section-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .about-list {
    margin: 0;
    padding: 0 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about-list li {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .about-list li::marker { color: var(--blue); }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
    align-items: center;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .contact-value {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  a.contact-value {
    color: var(--blue);
  }

  a.contact-value:hover { color: var(--blue-hover); }

  @media (max-width: 600px) {
    .about-wrapper { padding: 3rem 0 4rem; }
    .about-content { padding: 0 1rem; }
    .about-name { font-size: 1.75rem; }
  }
</style>
